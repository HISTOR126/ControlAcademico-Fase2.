@model DatosAcademicos
@{ViewData["Title"]="Panel principal";}
<div class="encabezado"><div><p class="ceja">RESUMEN GENERAL</p><h1>Panel académico</h1><p class="suave">Estudiantes, cursos y resultados en un solo lugar.</p></div><a class="boton primario" href="/academico/matriculas/nuevo">+ Nueva matrícula</a></div>
<section class="tarjetas"><article><span>Estudiantes registrados</span><strong>@Model.Estudiantes.Count</strong><a href="/academico/estudiantes">Ver estudiantes →</a></article><article><span>Cursos disponibles</span><strong>@Model.Cursos.Count</strong><a href="/academico/cursos">Consultar cursos →</a></article><article><span>Matrículas activas</span><strong>@Model.Matriculas.Count(m=>m.Activa)</strong><a href="/academico/matriculas">Gestionar matrículas →</a></article><article><span>Notas registradas</span><strong>@Model.Calificaciones.Count</strong><a href="/academico/calificaciones">Ver resultados →</a></article></section>
<section class="panel"><div class="encabezado"><div><h2>Matrículas recientes</h2><p class="suave">Últimos registros del sistema</p></div><a href="/academico/matriculas">Ver todas</a></div><div class="tabla"><table><thead><tr><th>Matrícula</th><th>Estudiante</th><th>Curso</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var m in Model.Matriculas.Take(6)){var e=Model.Estudiantes.Single(e=>e.Id==m.EstudianteId);var c=Model.Cursos.Single(c=>c.Id==m.CursoId);<tr><td><strong>@m.Codigo</strong></td><td>@e.Nombre @e.Apellido<small>@e.Carnet</small></td><td>@c.Codigo</td><td><span class="insignia @(m.Activa?"verde":"gris")">@(m.Activa?"Activa":"Cancelada")</span></td><td><a href="/academico/matriculas/@m.Id">Ver detalle</a></td></tr>}
@if(!Model.Matriculas.Any()){<tr><td colspan="5">Aún no hay matrículas. Registre la primera.</td></tr>}
</tbody></table></div></section>
<section class="panel api"><div><p class="ceja">CONSULTA DE ESTUDIANTE</p><h2>Servicio de notas y matrículas</h2><p>Consulte el estado académico por carnet. El resultado se entrega en formato JSON.</p><a class="boton" href="/api/estudiantes/CT-0001/situacion">Consultar ejemplo CT-0001 →</a></div></section>
