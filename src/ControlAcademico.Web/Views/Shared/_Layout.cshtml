<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · Control Académico</title><link rel="stylesheet" href="~/css/sitio.css" asp-append-version="true"></head>
<body><a class="saltar" href="#contenido">Saltar al contenido</a><aside><a class="marca" href="/">CA<span>Control Académico</span></a><p class="nav-label">GESTIÓN ACADÉMICA</p><nav><a href="/" class="@(Context.Request.Path == "/" ? "actual" : "")">Panel principal</a>
@foreach(var modulo in AcademicoService.Modulos){<a class="@(Context.Request.Path.StartsWithSegments("/academico/"+modulo)?"actual":"")" href="/academico/@modulo">@(modulo switch {"matriculas"=>"Matrículas","calificaciones"=>"Calificaciones",_=>char.ToUpper(modulo[0])+modulo[1..]})</a>}
</nav><div class="pie-menu">Proyecto de cátedra<br><strong>DSP404 · Fase 2</strong></div></aside>
<div class="pagina"><header><span>Institución educativa / Control académico</span><span class="avatar" aria-label="Panel académico">CA</span></header><main id="contenido">
@if(TempData["Exito"] is string mensaje){<div class="exito" role="status">@mensaje</div>}
@RenderBody()</main><footer>Sistema de Control Académico · Universidad Don Bosco</footer></div></body></html>
