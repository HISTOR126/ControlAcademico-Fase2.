@model PaginaAcademica
@{ViewData["Title"]="Eliminar · "+Model.Titulo;var f=Model.Formulario;}
<a class="volver" href="/academico/@Model.Modulo">← Volver al listado</a><section class="panel confirmacion"><p class="ceja">CONFIRMAR ELIMINACIÓN</p><h1>¿Eliminar este registro?</h1><p>@Model.Etiqueta(AcademicoService.Obtener(Model.Datos,Model.Modulo,f.Id))</p><p>Se eliminará de la base de datos. Los registros con dependencias deben resolverse primero.</p><div asp-validation-summary="All" class="error" role="alert"></div><form method="post" action="/academico/@Model.Modulo/@f.Id/eliminar">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@f.Version"><div class="botonera"><button class="boton borrar" type="submit">Eliminar registro</button><a class="boton secundario" href="/academico/@Model.Modulo/@f.Id">Conservar registro</a></div></form></section>
